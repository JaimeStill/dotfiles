#!/bin/bash
# Super + L on Omarchy 4.5+: cycle the active workspace between tiling (dwindle)
# and scrolling only, never floating. Wraps the stock toggle so its saving and
# notifications still apply. Stock order: dwindle -> scrolling -> floating ->
# dwindle; back from scrolling is dwindle. A floating workspace goes to dwindle.
if [[ $(omarchy-hyprland-workspace-layout-current) == scrolling ]]; then
  exec omarchy-hyprland-workspace-layout-toggle back
else
  exec omarchy-hyprland-workspace-layout-toggle
fi
