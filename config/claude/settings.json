{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "plan"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/jaime/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "github-cli@tau-marketplace": true,
    "marathon@standards-lab": true,
    "marathon-architecture@standards-lab": true
  },
  "extraKnownMarketplaces": {
    "tau-marketplace": {
      "source": {
        "source": "github",
        "repo": "tailored-agentic-units/tau-marketplace"
      }
    },
    "standards-lab": {
      "source": {
        "source": "github",
        "repo": "standards-lab/claude-plugins"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "verbose": true,
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "idleCompaction": false
}
