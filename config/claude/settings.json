  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "github-cli@tau-marketplace": true,
    "project-management@tau-marketplace": true,
    "marathon@standards-lab": true,
    "marathon-roadmap@standards-lab": true
  },
  "extraKnownMarketplaces": {
    "tau-marketplace": {
      "source": {
